{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aure",
  "version": "0.1.0",
  "identifier": "local.jingji.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "aure",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost http://jingji.localhost; media-src 'self' blob: asset: http://asset.localhost http://jingji.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] },
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "hengchuanmalu",
    "shortDescription": "Windows 本地优先的图片与视频管理应用",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "../resources/third-party-licenses.txt": "licenses/THIRD_PARTY_LICENSES.txt",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../LICENSE": "licenses/LICENSE.txt"
    },
    "windows": {
      "minimumWebview2Version": "111.0.0.0",
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": false },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "compression": "lzma"
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
