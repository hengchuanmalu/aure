{
  "name": "aure",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:boundaries && tsc --noEmit && vite build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:installed": "node scripts/check-installed.mjs",
    "verify": "npm run build && npm run check:performance && npm run check:size && npm test",
    "verify:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release.ps1",
    "desktop:build-test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-test-app.ps1",
    "test:native:release": "node scripts/test-native-release.mjs",
    "test:install-backups": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/unit/install-backups.ps1",
    "check:webview2": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-webview2.ps1",
    "test:webview2-preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/unit/webview2-preflight.ps1",
    "check:open-source": "node scripts/prepare-open-source.mjs --check",
    "prepare:open-source": "node scripts/prepare-open-source.mjs",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local.ps1",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "~2.12.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "match-sorter": "8.3.0",
    "motion": "^12.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
